rules_version = '2';

// Règles de sécurité du site Gbola PSD.
// - Tout le monde peut LIRE le contenu du site (site/content et site/photo).
// - Tout le monde peut ENVOYER un message, sans pouvoir le relire.
// - Seul l'administrateur peut modifier le site et lire les messages.
// ⚠️ Même liste que ADMIN_EMAILS dans js/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['oloukoulau@gmail.com', 'chaffacenuel679@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'subject', 'message', 'createdAt', 'read'])
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.email, 3, 200)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && str(request.resource.data.phone, 0, 40)
        && str(request.resource.data.subject, 0, 200)
        && str(request.resource.data.message, 5, 5000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
